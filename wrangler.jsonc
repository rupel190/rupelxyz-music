{
  // Static-assets Worker: serves the Vite build output in ./dist, which nests every page
  // under music/ so the paths line up with the route below.
  // The CI deploy command (`npx wrangler deploy`) needs this to know what to ship.
  "name": "rupelxyz-music",
  // `music*` rather than `music/*` so a bare /music reaches this worker too, which redirects
  // it to /music/. Nothing else on rupel.xyz starts with "music".
  "routes": [{ "pattern": "rupel.xyz/music*", "zone_name": "rupel.xyz" }],
  // Only the route serves the site: no *.workers.dev name, no per-version preview URLs.
  "workers_dev": false,
  "preview_urls": false,
  "compatibility_date": "2025-06-18",
  "assets": {
    "directory": "./dist"
  }
}
